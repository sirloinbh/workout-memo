POSTGRES_DB=workout
POSTGRES_USER=workout
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://workout:change-this-local-password@localhost:15401/workout
PORT=3101
# The shared sign-in (#303). Unset for local development without it; compose sets it on the server.
# AUTH_INTERNAL_URL=http://shared-auth-api:3110
# Web Push for the weekly summary (#260, #485). Leave unset to turn push off. Generate a key pair once (docs/deployment.md);
# never commit the private key. VAPID_SUBJECT is a mailto: or https: contact (default: the app address).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# shared-ai's Ed25519 public key (PEM, one line with \n escapes; #334, #346). Set: the API serves its AI tools at
# /internal/tools; empty: no tools. The server deploy reads it from SSM. @secret @ssm=/sirloinbh/shared/ai-tools-public-key
AI_TOOLS_PUBLIC_KEY=
