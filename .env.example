POSTGRES_DB=workout
POSTGRES_USER=workout
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://workout:change-this-local-password@localhost:15401/workout
PORT=3101
# The shared sign-in (#303). Unset for local development without it; compose sets it on the server.
# AUTH_INTERNAL_URL=http://shared-auth-api:3110
# Rest-end Web Push (#260). Leave unset to turn push off. Generate a key pair once (docs/deployment.md);
# never commit the private key. VAPID_SUBJECT is a mailto: or https: contact (default: the app address).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
