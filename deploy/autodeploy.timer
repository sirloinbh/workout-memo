# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Check origin/main of workout-memo for a new CI-passed commit every 2 minutes

[Timer]
# The boot delay grows by 10 seconds per registry slot (slot 1) so apps do not all check at once (ADR-0009).
OnBootSec=3min 10s
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
