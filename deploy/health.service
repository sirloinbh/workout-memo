# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Workout Log health check signal for healthchecks.io
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/workout-memo
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/workout-memo/deploy/notify.sh /tmp/workout-notify.sh && exec /bin/bash /tmp/workout-notify.sh health'
TimeoutStartSec=2min
