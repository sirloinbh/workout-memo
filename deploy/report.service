# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Workout Log daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/workout-memo
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/workout-memo/deploy/report.sh /tmp/workout-report.sh && exec /bin/bash /tmp/workout-report.sh'
TimeoutStartSec=5min
