# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Workout Log weekly restore check of the newest database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/workout-memo
ExecStart=/bin/bash -c 'cp /opt/workout-memo/deploy/backup.sh /tmp/workout-restore-check.sh && exec /bin/bash /tmp/workout-restore-check.sh verify'
TimeoutStartSec=30min
Nice=10
