          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "default": ""
          },
          "feedback": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "hard",
              "medium",
              "easy"
            ],
            "default": null
          },
          "sets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "exercise": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "machine_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "exclusiveMinimum": 0,
                  "default": null
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 99999
                },
                "reps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "notes": {
                  "type": "string",
                  "maxLength": 4000,
                  "default": ""
                },
                "completed": {
                  "type": "boolean",
                  "default": true
                },
                "rpe": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 10,
                  "default": null
                }
              },
              "required": [
                "exercise",
                "weight",
                "reps"
              ]
            },
            "minItems": 1,
            "maxItems": 200
          }
        },
        "required": [
          "date",
          "title",
          "sets"
        ]
      },
      "BodyPartMapping": {
        "type": "object",
        "properties": {
          "exercise": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "body_parts": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "가슴",
                "등",
                "어깨",
                "팔",
                "하체-앞",
                "하체-뒤",
                "복근"
              ]
            },
            "maxItems": 7
          }
        },
        "required": [
          "exercise",
          "body_parts"
        ]
      }
    }
