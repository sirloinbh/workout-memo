            "type": "number",
            "minimum": 0,
            "maximum": 99999
          },
          "target_reps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "deadline": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
