        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Workout"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공"
          },
          "400": {
            "description": "입력 검증 실패 또는 존재하지 않는 참조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
