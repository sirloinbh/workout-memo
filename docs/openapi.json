{
  "openapi": "3.1.0",
  "info": {
    "title": "Workout Memo API",
    "version": "1.0.0",
    "description": "개인 운동 일지 API. 날짜는 YYYY-MM-DD(Asia/Seoul), 중량은 기본중량 포함 총중량 kg. 응답 본문과 교차 필드 규칙은 docs/api.md를 참고하세요."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/body-measurements/{id}": {
      "delete": {
        "summary": "신체 기록 삭제 → { ok: true }",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공"
          },
          "404": {
            "description": "대상 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "신체 기록 전체 교체. 생략한 값은 null",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BodyMeasurement"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공"
          },
          "400": {
            "description": "입력 검증 실패 또는 존재하지 않는 참조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "대상 없음",
