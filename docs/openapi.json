          "body_weight_kg": {
            "type": [
              "number",
              "null"
            ],
            "default": null
          },
          "body_fat_percent": {
            "type": [
              "number",
              "null"
            ],
            "default": null
          },
          "skeletal_muscle_kg": {
            "type": [
              "number",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "date"
        ]
      },
      "Goal": {
        "type": "object",
