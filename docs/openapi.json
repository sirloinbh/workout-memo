              "merge",
              "replace"
            ],
            "default": "merge"
          },
          "confirm": {
            "type": "string"
          },
          "backup": {}
        }
      },
      "BodyMeasurement": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
