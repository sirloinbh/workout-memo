                      "rep_min": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "rep_max": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      }
                    },
                    "required": [
                      "exercise",
                      "sets",
                      "weight",
                      "reps"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 100
                }
              },
              "required": [
                "name",
                "body_parts",
                "exercises"
              ]
            },
            "minItems": 1,
            "maxItems": 5
          },
          "weeks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "week": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "increase_weight",
                    "increase_reps",
                    "deload"
                  ]
                },
                "amount": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 99999
                },
                "deload_metric": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "weight",
                    "sets",
                    "reps"
                  ]
                }
              },
              "required": [
                "week",
                "kind",
                "amount",
                "deload_metric"
              ]
            },
            "minItems": 12,
            "maxItems": 12
          }
        },
        "required": [
          "name",
          "start_date",
          "split_count",
          "weekly_workouts",
          "rest_days",
          "splits"
        ]
      },
      "RoutineRest": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
