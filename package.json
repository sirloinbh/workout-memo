{
  "name": "workout-memo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "db:migrate": "npm run db:migrate -w backend --",
    "openapi": "npm run openapi -w backend",
    "test:skills": "node --test scripts/test/claude-skills.test.mjs",
    "test:docs": "node --test scripts/test/docs-commands.test.mjs",
    "test:e2e": "playwright test",
    "skills:sync": "node scripts/claude-skills.mjs sync",
    "skills:check": "node scripts/claude-skills.mjs",
    "contract:sync": "node scripts/contract.mjs sync",
    "contract:check": "node scripts/contract.mjs && node --test scripts/test/contract.test.mjs",
    "check": "npm run format:check && npm run lint && npm run contract:check && npm run typecheck && npm test && npm run test:skills && npm run test:docs && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json",
    "standards:check": "node .standards/check.mjs",
    "lockfiles:sync": "node .standards/lockfiles.mjs --write",
    "knip": "knip"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@sirloinbh/eslint-config": "1.1.0",
    "@sirloinbh/prettier-config": "1.0.0",
    "concurrently": "9.2.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "16.5.0",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript-eslint": "8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
